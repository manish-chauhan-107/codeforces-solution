#include <bits/stdc++.h>
using namespace std;
 
int main(){
  int n;
  cin>>n;
  string b ;
  while (n--){
      cin>>b;
      for (int i = 0 ; i < b.size() ; i++ ){
         b[i] = toupper(b[i]);
      }
      if (b == "YES"){
         cout<<"YES"<<endl;
      }
      else{
         cout<<"NO"<<endl;
      }
  }
 return 0;
}